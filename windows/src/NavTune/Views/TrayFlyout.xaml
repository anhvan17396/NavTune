<Window x:Class="NavTune.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NavTune.Infrastructure"
        xmlns:c="clr-namespace:NavTune.Controls"
        Title="NavTune" Width="372" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True" WindowStartupLocation="Manual"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Window.Resources>
        <Style x:Key="SmallChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="12" Padding="9,5" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource BrandGradient}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource BrandRedSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource BrandRedBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HiddenScroll" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="HorizontalOnly" />
        </Style>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <StackPanel Margin="16,14,16,14">
            <!-- Header -->
            <DockPanel Margin="0,0,0,12">
                <Image DockPanel.Dock="Left" Source="{x:Static l:BrandIcon.AppImage}" Width="30" Height="30" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsOn}" VerticalAlignment="Center" />
                <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="NavTune" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ActiveDeviceGlyph}" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,5,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActiveDeviceName}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="210"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding IssueText}" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,0,10"
                       Visibility="{Binding HasIssue, Converter={StaticResource Visible}}" />

            <!-- Mini graph -->
            <Grid Height="72" Margin="0,0,0,12" IsEnabled="{Binding IsOn}">
                <c:FrequencyGraph State="{Binding}" ShowGrid="False" CornerRadius="8" />
                <TextBlock Text="{Binding CurrentPresetName}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="8,6" />
            </Grid>

            <StackPanel IsEnabled="{Binding IsOn}">
                <!-- Presets -->
                <ScrollViewer Style="{StaticResource HiddenScroll}" Margin="0,0,0,12" x:Name="PresetScroller">
                    <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SmallChip}" Command="{Binding ApplyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,5,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Auto preset by content -->
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoPreset}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Tự chọn preset theo nội dung', 'Auto preset by content'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding DetectedContentText}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding AutoPreset, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </CheckBox>

                <!-- Device -->
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="{l:Tr 'Thiết bị', 'Device'}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" />
                </DockPanel>

                <!-- Bass and boost -->
                <DockPanel Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="{x:Static l:Glyphs.Bass}" Style="{StaticResource Glyph}" Width="18" Margin="0,0,8,0" Foreground="{StaticResource BrandAccentBrush}" />
                    <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding BassText}" />
                    </Border>
                    <TextBlock Text="Bass" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
                <Slider Minimum="-12" Maximum="12" Value="{Binding Bass}" SmallChange="0.5" LargeChange="3" Margin="0,0,0,8" />
                <DockPanel Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="{x:Static l:Glyphs.Boost}" Style="{StaticResource Glyph}" Width="18" Margin="0,0,8,0" Foreground="{StaticResource BrandAccentBrush}" />
                    <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding BoostText}" />
                    </Border>
                    <TextBlock Text="{l:Tr 'Tăng âm lượng', 'Volume boost'}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
                <Slider Minimum="0" Maximum="12" Value="{Binding Boost}" SmallChange="0.5" LargeChange="3" Margin="0,0,0,10" />

                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Bypass}" Margin="0,0,0,10"
                          Content="{l:Tr 'Nghe bản gốc (so sánh)', 'Original sound (compare)'}" />

                <!-- Quick mute -->
                <StackPanel Visibility="{Binding HasQuickMuteApps, Converter={StaticResource Visible}}" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                               Text="{l:Tr 'Tắt tiếng ở loa (ứng dụng vẫn chạy)', 'Mute on speakers (apps keep running)'}" />
                    <ScrollViewer Style="{StaticResource HiddenScroll}">
                        <ItemsControl ItemsSource="{Binding QuickMuteApps}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SmallChip}" Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MuteTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="120" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock x:Name="State" Text="{x:Static l:Glyphs.Volume}" Style="{StaticResource Glyph}" FontSize="10" Margin="5,0,0,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter TargetName="State" Property="Text" Value="{x:Static l:Glyphs.Mute}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            <Separator Margin="0,2,0,10" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr 'Thoát', 'Quit'}" Click="OnQuit" />
                <Button Content="{l:Tr 'Mở NavTune', 'Open NavTune'}" Click="OnOpen" HorizontalAlignment="Left" Style="{DynamicResource AccentButtonStyle}" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
