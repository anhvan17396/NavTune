<UserControl x:Class="NavTune.Views.EqualizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NavTune.Infrastructure"
             xmlns:c="clr-namespace:NavTune.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,4,24,28" IsEnabled="{Binding IsOn}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IssueBanner}" Focusable="False" />

            <!-- Mode, and auto preset by content (as on macOS) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="EqMode" IsChecked="{Binding IsGraphic}"
                                     Content="{l:Tr 'Đồ hoạ 10 băng', 'Graphic (10 bands)'}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="EqMode" IsChecked="{Binding IsParametric}"
                                     Content="{l:Tr 'Tham số (nâng cao)', 'Parametric (advanced)'}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,16,0"
                            Visibility="{Binding AutoPreset, Converter={StaticResource Visible}}">
                    <TextBlock Text="{x:Static l:Glyphs.Wave}" FontSize="14" Margin="0,0,6,0" Foreground="{StaticResource BrandAccentBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                <Style.Triggers>
                                    <!-- Pulses while listening, until something recognizable is heard. -->
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Pulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.8"
                                                                     AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DetectedContentText}" Style="{StaticResource Secondary}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding AutoPreset}" VerticalAlignment="Center"
                          Content="{l:Tr 'Tự chọn preset theo nội dung', 'Auto preset by content'}"
                          ToolTip="{l:Tr 'NavTune nghe nội dung đang phát (giọng nói, guitar, synth, piano, dàn nhạc…) và tự chọn preset phù hợp. Chạy hoàn toàn trên máy, không gửi âm thanh đi đâu.', 'NavTune listens to what is playing (speech, guitar, synth, piano, orchestra…) and picks a matching preset. Runs entirely on your PC; no audio leaves it.'}" />
            </Grid>

            <!-- Graphic EQ -->
            <StackPanel Visibility="{Binding IsGraphic, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,14">
                    <c:FrequencyGraph State="{Binding}" Height="200" />
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <c:IconBadge Glyph="{x:Static l:Glyphs.Equalizer}" DockPanel.Dock="Left" />
                            <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding CurrentPresetName}" />
                            </Border>
                            <TextBlock Style="{StaticResource Headline}" Margin="10,0,0,0" Text="{l:Tr 'Bộ chỉnh âm 10 băng', '10-band equalizer'}" />
                        </DockPanel>
                        <Grid Height="236">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,28,0,30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="+12" Style="{StaticResource Caption}" FontSize="10" />
                                <TextBlock Grid.Row="2" Text="0" Style="{StaticResource Caption}" FontSize="10" />
                                <TextBlock Grid.Row="4" Text="-12" Style="{StaticResource Caption}" FontSize="10" />
                            </Grid>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding GraphicBands}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock x:Name="GainLabel" DockPanel.Dock="Top" Text="{Binding GainText}" HorizontalAlignment="Center"
                                                       FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource BrandAccentBrush}" />
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding FrequencyLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <c:VerticalSlider Value="{Binding Gain}" Margin="0,6,0,2" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsZero}" Value="True">
                                                <Setter TargetName="GainLabel" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EqFooter}" Margin="0,16,0,0" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Parametric EQ -->
            <StackPanel Visibility="{Binding IsParametric, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <c:IconBadge Glyph="{x:Static l:Glyphs.Dial}" DockPanel.Dock="Left" />
                            <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding CurrentPresetName}" />
                            </Border>
                            <TextBlock Style="{StaticResource Headline}" Margin="10,0,0,0" Text="{l:Tr 'EQ tham số', 'Parametric EQ'}" />
                        </DockPanel>
                        <c:FrequencyGraph State="{Binding}" ShowNodes="True" Height="260" Margin="0,0,0,12" />

                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="{l:Tr 'Kéo các điểm trên biểu đồ để chỉnh', 'Drag the points on the graph'}" />
                            <ItemsControl ItemsSource="{Binding ParametricBands}" Focusable="False" DockPanel.Dock="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding Tooltip}"
                                                Command="{Binding DataContext.SelectBandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Chip" Width="46" Height="38" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <TextBlock x:Name="Freq" Text="{Binding FrequencyShort}" FontSize="11" HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter TargetName="Chip" Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource BrandGradient}" />
                                                            <Setter TargetName="Num" Property="Foreground" Value="White" />
                                                            <Setter TargetName="Freq" Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding AddBandCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static l:Glyphs.Add}" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:Tr 'Thêm băng', 'Add band'}" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- Selected band -->
                        <Border Style="{StaticResource Inset}" DataContext="{Binding SelectedBand}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveBandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Static l:Glyphs.Delete}" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                            <TextBlock Text="{l:Tr 'Xoá băng', 'Remove band'}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{l:Tr 'Kiểu lọc', 'Filter type'}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ComboBox Width="230" VerticalAlignment="Center" DisplayMemberPath="Title" SelectedValuePath="Kind"
                                              ItemsSource="{Binding DataContext.FilterKinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding Kind}" />
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="18,0,0,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Content="{l:Tr 'Bật', 'On'}" />
                                </DockPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,18,0">
                                        <DockPanel Margin="0,0,0,6">
                                            <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding FrequencyText}" />
                                            </Border>
                                            <TextBlock Text="{l:Tr 'Tần số', 'Frequency'}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding FrequencyPosition}" SmallChange="0.005" LargeChange="0.05" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,0">
                                        <DockPanel Margin="0,0,0,6">
                                            <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding GainText}" />
                                            </Border>
                                            <TextBlock Text="{l:Tr 'Mức', 'Gain'}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding Gain}" SmallChange="0.5" LargeChange="3" IsEnabled="{Binding HasGain}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding QText}" />
                                            </Border>
                                            <TextBlock Text="{l:Tr 'Độ rộng (Q)', 'Width (Q)'}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding QPosition}" SmallChange="0.01" LargeChange="0.1" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EqFooter}" Focusable="False" />
                </Border>
            </StackPanel>

            <!-- Presets -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHeader}">
                        <c:IconBadge Glyph="{x:Static l:Glyphs.Presets}" DockPanel.Dock="Left" />
                        <TextBlock Style="{StaticResource Headline}" Margin="10,0,0,0" Text="{l:Tr 'Preset theo dòng nhạc', 'Genre presets'}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="160" ItemHeight="44" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PresetChip}" Command="{Binding ApplyCommand}" Margin="0,0,8,8" ToolTip="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Width="18" Margin="0,0,8,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="110" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
