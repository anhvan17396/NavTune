<Window x:Class="NavTune.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="Message" Style="{StaticResource Secondary}" Margin="0,0,0,14" />
        <TextBox x:Name="Input" Margin="0,0,0,18" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="Ok" IsDefault="True" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
