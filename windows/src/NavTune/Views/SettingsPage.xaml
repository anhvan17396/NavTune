<UserControl x:Class="NavTune.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NavTune.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,4,24,28">
            <TextBlock Style="{StaticResource SectionHeader}" Margin="2,0,0,8" Text="{l:Tr 'Chung', 'General'}" />
            <Border Style="{StaticResource Card}" Padding="16,6" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel Margin="0,8">
                        <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Title" />
                        <TextBlock Text="{l:Tr 'Ngôn ngữ', 'Language'}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                    <Separator Margin="0,4" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LaunchAtLogin}" Margin="0,10"
                              Content="{l:Tr 'Khởi động cùng Windows', 'Launch at sign-in'}" />
                    <Separator Margin="0,4" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" Margin="0,10"
                              Content="{l:Tr 'Đóng cửa sổ thì NavTune vẫn chạy ở khay hệ thống', 'Keep NavTune running in the tray when the window is closed'}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Margin="2,0,0,8" Text="{l:Tr 'Quyền riêng tư', 'Privacy'}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{x:Static l:Glyphs.Shield}" Style="{StaticResource Glyph}" FontSize="18" Margin="0,0,12,0"
                               VerticalAlignment="Top" Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock Style="{StaticResource Secondary}"
                               Text="{l:Tr 'Âm thanh chỉ được xử lý ngay trên máy, không ghi lại và không gửi đi đâu. NavTune không cần quyền quản trị và không cài driver.', 'Audio is processed only on this PC: never recorded or sent anywhere. NavTune needs no administrator rights and installs no driver.'}" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Margin="2,0,0,8" Text="{l:Tr 'Dữ liệu', 'Data'}" />
            <Border Style="{StaticResource Card}" Padding="16,16,8,8" Margin="0,0,0,18">
                <WrapPanel>
                    <Button Command="{Binding ShowWelcomeCommand}" Margin="0,0,8,8" Content="{l:Tr 'Xem lại hướng dẫn ban đầu', 'Show the welcome guide again'}" />
                    <Button Command="{Binding OpenSoundSettingsCommand}" Margin="0,0,8,8" Content="{l:Tr 'Mở cài đặt âm thanh của Windows', 'Open Windows sound settings'}" />
                    <Button Command="{Binding OpenLogCommand}" Margin="0,0,8,8" Content="{l:Tr 'Mở thư mục nhật ký', 'Open the log folder'}" />
                    <Button Command="{Binding ResetAllSoundCommand}" Margin="0,0,8,8" Content="{l:Tr 'Khôi phục cài đặt âm thanh mặc định…', 'Reset sound settings…'}" />
                </WrapPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Margin="2,0,0,8" Text="{l:Tr 'Giới thiệu', 'About'}" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{x:Static l:BrandIcon.AppImage}" Width="56" Height="56" />
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding OpenWebsiteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static l:Glyphs.Globe}" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="navtools.vn" />
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NavTune" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Secondary}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr 'Ứng dụng miễn phí thuộc hệ sinh thái navtools.vn.', 'A free app from the navtools.vn family.'}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
