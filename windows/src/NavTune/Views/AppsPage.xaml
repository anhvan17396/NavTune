<UserControl x:Class="NavTune.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NavTune.Infrastructure"
             xmlns:c="clr-namespace:NavTune.Controls">
    <UserControl.Resources>
        <!-- Mute toggle: red with a crossed speaker when muted. -->
        <Style x:Key="MuteButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Width="36" Height="28" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="Glyph" Text="{x:Static l:Glyphs.Volume}" Style="{StaticResource Glyph}" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource BrandRedBrush}" />
                                <Setter TargetName="Glyph" Property="Text" Value="{x:Static l:Glyphs.Mute}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,4,24,28" IsEnabled="{Binding IsOn}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IssueBanner}" Focusable="False" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHeader}">
                        <c:IconBadge Glyph="{x:Static l:Glyphs.Apps}" DockPanel.Dock="Left" />
                        <TextBlock Style="{StaticResource Headline}" Margin="10,0,0,0" Text="{l:Tr 'Âm thanh riêng cho từng ứng dụng', 'Per-app sound'}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Secondary}"
                               Text="{l:Tr 'Mọi ứng dụng đều phát qua NavTune với EQ chung. Ở đây anh có thể tắt tiếng hoặc giảm âm lượng riêng cho từng ứng dụng; NavTune nhớ lựa chọn và tự áp dụng mỗi khi ứng dụng phát lại.', 'Every app plays through NavTune with the main EQ. Here you can mute an app or lower its own volume; NavTune remembers your choice and applies it whenever the app plays again.'}" />
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{x:Static l:Glyphs.Mute}" Style="{StaticResource Glyph}" FontSize="14" VerticalAlignment="Top"
                                   Margin="0,2,8,0" Foreground="{StaticResource BrandRedBrush}" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Text="{l:Tr 'Tắt tiếng: ứng dụng vẫn chạy bình thường, chỉ không phát ra loa và tai nghe. Tắt NavTune thì mọi ứng dụng có tiếng lại.', 'Mute: the app keeps running, it just isn’t heard on your speakers or headphones. Turn NavTune off and every app is heard again.'}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasApps, Converter={StaticResource Hidden}}" Padding="16,26">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static l:Glyphs.Music}" Style="{StaticResource Glyph}" FontSize="30" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center"
                               Text="{l:Tr 'Chưa có ứng dụng nào dùng âm thanh. Mở YouTube, Spotify… rồi quay lại đây.', 'No apps are using audio yet. Open YouTube, Spotify… and come back here.'}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36" Margin="0,0,12,0">
                                    <Image x:Name="Icon" Source="{Binding Icon}" Width="32" Height="32" />
                                    <TextBlock Text="{x:Static l:Glyphs.Apps}" Style="{StaticResource Glyph}" FontSize="22"
                                               Visibility="{Binding Icon, Converter={StaticResource Hidden}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource MuteButton}" Command="{Binding ToggleMuteCommand}"
                                        ToolTip="{Binding MuteTooltip}" Margin="12,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{l:Tr 'Âm lượng', 'Volume'}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Slider Width="170" Minimum="0" Maximum="100" Value="{Binding Volume}" SmallChange="1" LargeChange="10"
                                            VerticalAlignment="Center" IsEnabled="{Binding IsMuted, Converter={StaticResource Not}}" />
                                    <Border Style="{StaticResource Pill}" Width="58" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding VolumeText}" HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BrandRedBrush}" />
                                <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,0"
                       Text="{l:Tr 'Trên Windows, phần mềm thu âm thanh hệ thống (OBS, ghi màn hình…) cũng không thu được tiếng của ứng dụng đã tắt tiếng.', 'On Windows, apps that record system audio (OBS, screen recorders…) don’t capture a muted app either.'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
