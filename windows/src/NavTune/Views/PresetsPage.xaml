<UserControl x:Class="NavTune.Views.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NavTune.Infrastructure"
             xmlns:c="clr-namespace:NavTune.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="PresetRow">
            <Border x:Name="Row" Padding="10,7" CornerRadius="6" Background="Transparent">
                <DockPanel>
                    <c:IconBadge DockPanel.Dock="Left" Glyph="{Binding Glyph}" Size="26" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <c:PresetCurve Gains="{Binding Gains}" Width="96" Height="26" Margin="0,0,16,0" />
                        <TextBlock Text="{x:Static l:Glyphs.Check}" Style="{StaticResource Glyph}" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{StaticResource BrandGreenBrush}" Visibility="{Binding IsSelected, Converter={StaticResource Visible}}" />
                        <Button Content="{l:Tr 'Dùng', 'Use'}" Command="{Binding ApplyCommand}" MinWidth="72"
                                IsEnabled="{Binding IsSelected, Converter={StaticResource Not}}" />
                        <Button Style="{StaticResource IconButton}" Content="{x:Static l:Glyphs.Delete}" Command="{Binding DeleteCommand}" Margin="6,0,0,0"
                                ToolTip="{l:Tr 'Xoá preset', 'Delete preset'}" Visibility="{Binding IsUser, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="280" VerticalAlignment="Center"
                                 Visibility="{Binding IsUser, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding IsUser, Converter={StaticResource Hidden}}" />
                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Visibility="{Binding IsParametric, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource PillText}" FontSize="11" Text="{l:Tr 'Tham số', 'Parametric'}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="28,4,24,14">
            <Button DockPanel.Dock="Left" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SavePresetCommand}" IsEnabled="{Binding IsOn}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static l:Glyphs.Add}" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                    <TextBlock Text="{l:Tr 'Lưu EQ hiện tại…', 'Save current EQ…'}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding ExportPresetsCommand}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static l:Glyphs.Export}" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="{l:Tr 'Xuất…', 'Export…'}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding ImportPresetsCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static l:Glyphs.Import}" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="{l:Tr 'Nhập…', 'Import…'}" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding PresetMessage}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,0,24,28">
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Preset của tôi', 'My presets'}" />
                <Border Style="{StaticResource Card}" Padding="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Margin="12,10" Visibility="{Binding HasUserPresets, Converter={StaticResource Hidden}}"
                                   Text="{l:Tr 'Chưa có preset nào. Chỉnh EQ theo ý anh rồi bấm “Lưu EQ hiện tại…”. Có thể nhập file preset xuất từ NavTune trên Mac.', 'No presets yet. Shape the EQ the way you like, then click “Save current EQ…”. Preset files exported from NavTune on a Mac can be imported too.'}" />
                        <ItemsControl ItemsSource="{Binding UserPresets}" ItemTemplate="{StaticResource PresetRow}" Focusable="False" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SectionHeader}" Margin="2,20,0,8" Text="{l:Tr 'Preset có sẵn', 'Built-in presets'}" />
                <Border Style="{StaticResource Card}" Padding="6">
                    <ItemsControl ItemsSource="{Binding BuiltInPresets}" ItemTemplate="{StaticResource PresetRow}" Focusable="False" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
