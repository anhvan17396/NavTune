<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NavTune</RootNamespace>
    <AssemblyName>NavTune</AssemblyName>
    <ApplicationIcon>Assets\NavTune.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>NavTune.Program</StartupObject>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.4</FileVersion>
    <Product>NavTune</Product>
    <Company>navtools.vn</Company>
    <Copyright>© navtools.vn</Copyright>
    <Description>NavTune – chỉnh âm thanh toàn hệ thống</Description>
    <NeutralLanguage>vi</NeutralLanguage>
    <!-- The Fluent theme (ThemeMode) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\NavTune.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NavTune.Core\NavTune.Core.csproj" />
  </ItemGroup>

</Project>
